; ============================================================================
; NyaoScalper_allday —— +154那套配置，但全天跑（不限时段）
;   用途: 对比早上 vs 下午的盈利。参数与 NyaoScalper_scalp(+154) 完全相同,
;   唯一区别: InpUseSession=false(0-23全天) + InpMagic=20260930(独立筛报告)。
;   硬规则仍在: 数据前后30分钟不做 / ATR太低不做 / 每笔带止损。
;   出场: 止损金价$10, 止盈1:1.5(约$15), 0.7R起追踪, 1R移保本, 无利润地板。
; ============================================================================
InpFixedLot=0.01
InpMagic=20260930
InpMaxPositions=2
InpSignalTF=1
InpEmaFast=12
InpEmaSlow=26
InpSlopeLookback=3
InpRsiPeriod=14
InpAtrPeriod=14
InpAvgAtrPeriod=50
InpBodyAvgBars=10
InpPeakLookback=5
InpMinSignalScore=4.5
InpSmoothCandles=1
InpMinVolRatio=0.65
InpNewBarOnly=true
InpWTrendAlign=1.5
InpWTrendSlope=1.5
InpWRsiSweet=1.0
InpWRsiBreak=0.5
InpWBody=1.5
InpWChopHigh=2.0
InpWVolExpand=1.0
InpWPeakBreak=1.0
InpAtrMinUSD=0.60
InpAtrMaxUSD=20.0
InpUseRegime=true
InpRegimeBars=20
InpTrendER=0.45
InpRangeER=0.28
InpNoTradeER=0.15
InpRequireMicroAgree=false
InpMicroBars=3
InpRangeEdge=0.35
InpUseSmartLevels=true
InpSpikeBars=5
InpMaxSpikeATR=2.5
InpKeyGuardATR=0.30
InpRoundStep=10.0
InpAsiaStartHour=3
InpAsiaEndHour=10
InpExtremeBars=15
InpNoChaseExtremeATR=0.0
InpExhaustBars=30
InpExhaustATR=0.0
InpMaxSpreadUSD=0.35
InpMaxSpreadATRRatio=0.25
InpFixedSlUSD=10.0
InpRRAtrMult=1.0
InpRiskReward=1.5
InpBreakevenUSD=0.0
InpUseBreakeven=true
InpBeBufferATR=0.05
InpUseTrail=true
InpTrailAtrMult=1.0
InpTrailStartR=0.7
InpProfitStallMin=0
InpProfitStallMinUSD=1.0
InpUseSession=false
InpSessStart=11
InpSessEnd=19
InpNewsTimes=
InpNewsBeforeMin=30
InpNewsAfterMin=30
InpMaxTradesPerDay=100000
InpDailyTargetUSD=100.0
InpDailyMaxLossUSD=0.0
InpMaxBasketLossPct=0.0
InpMinEquityUSD=0.0
InpConfidenceLot=false
InpConfidenceMult=1.5
InpMaxLot=0.05
InpDashboard=true
InpVerbose=true
