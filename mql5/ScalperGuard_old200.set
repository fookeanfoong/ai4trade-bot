; ============================================================================
; XAUUSD ScalperGuard —— 旧 aggressive 打法，本金缩到 $200
;
; 交易规则沿用 ScalperGuard_aggressive.set，只改四处（其余 99 个参数逐字相同）：
;     InpVirtualBalanceUSD    0.0   -> 200.0   本金缩到 $200
;     InpDirectionMode        1     -> 2       ↓ 这三条是为了让做空能发生
;     InpHtfRequireCloseSide  false -> true
;     InpHtfRequireSlope      false -> true
; 所有按百分比算的东西（单笔风险、日内限额、组合在险）改以 $200 为基准，
; 而不是终端里的真实余额。保证金检查不受影响 —— 那是券商的真实约束。
;
; ---- $200 下的实际金额 ----
;     B级 0.5% -> $1.00     A级 0.8% -> $1.60     A+级 1.0% -> $2.00
;     日亏上限 2% -> $4.00   日目标 25% -> $50
;     保守档 +10% -> $20     收紧档 +15% -> $30
;
;   注意 $4 的日亏上限 = **连亏 4 笔 B 级就收工**。这不是配错了，
;   $10,000 上是同一个比例（$200 上限 ÷ $50 每笔 = 同样 4 笔）。
;   日目标 $50 需要约 25~50R，一天基本摸不到 —— 但这一点在 $10,000 上
;   也一样（目标 $2483），也就是说日目标从来就是失效的，只有日亏上限在起作用。
;
; ---- $200 上唯一不能等比缩放的东西：手数取整 ----
;   最小手 0.001、步长 0.001。B 级冒 $1、止损 $8 时理论手数 0.0013，
;   向下取整成 0.001 —— 实际只冒了 $0.80，比目标低 20%。
;   $10,000 上手数在 0.02~0.1 量级，取整误差 1% 以内。
;   偏差方向是**变小**，不会超风险；但意味着实际风险比标称值低 10~25%，
;   算期望值时按 R 倍数看，别按百分比看。
;   止损宽到约 $12 以上时 0.5% 连最小手都开不出来，
;   这时 InpSmallAccountEscalate 会把风险抬到上限 1.0% 让它开得出来。
;
; ---- 和当前 sim200 档的差别（这才是"回到旧打法"的实质）----
;     单笔风险   1.5/3/5%  ->  0.5/0.8/1.0%      （小 3~5 倍）
;     日亏上限   50%       ->  2%                （小 25 倍）
;     每日笔数   80        ->  20
;     触发周期   M1        ->  M5
;     方向模式   3(M5定向) ->  1(H1定向)
;     ADX门槛    5         ->  12
;     评分门槛   3         ->  4
;     追高保护   3.0×ATR   ->  1.2×ATR
;
;   ---- 诊断档调整（用户要求：激进一点，看问题出在哪）----
;   直接要求的两条：
;     InpStopAfterConsecLoss   20 -> 30
;     InpDailyMaxLossPct      2% -> 30%  ($4 -> $60)
;   被迫跟着改的一条：
;     InpMaxTradesPerDay       20 -> 60   —— 20 笔/天的上限下"连亏 30 笔"永远到不了
;   激进一点（风险翻一倍，仍远低于 sim200 的 1.5/3/5）：
;     InpRiskPct B/A/A+  0.5/0.8/1.0 -> 1.0/1.5/2.0   ($2/$3/$4 每笔)
;     InpRiskPctMax             1.0 -> 2.0
;     InpAdxMin                  12 -> 9
;     InpLooseMaxDistATR       1.20 -> 1.80
;     InpMaxPositions             3 -> 4
;     InpMaxMarginPctPerPos     35% -> 80%（风险翻倍后止损窄的单子会撞保证金闸门）
;     InpObserveAfterConsecLoss   3 -> 10（否则连亏 3 笔就挂进观察模式一直压风险）
;
;   没动的：M5 触发（不是 M1）、评分门槛 4、方向模式 2 + H1 附加条件（做空保留）、
;   保本 0.5R、回吐 40%、止损上下限、组合在险 10%。
;
;   ⚠️ 两道闸门谁先到：每笔冒 $2 时 30 笔亏满 $60，正好和连亏门槛撞在一起；
;      冒 $3/$4 时 20/15 笔就到日亏上限，连亏 30 那道到不了。
;      也就是说实际先触发的多半仍是**日亏 $60**。
;
;   ---- 逆势闸门：正在升就别做空（实盘打脸补的一条）----
;   11:09 空 @4621.115、11:14 空 @4624.765，两笔都吃满止损 ——
;   当时价格正从 4621 往上走。
;
;   成因：模式 4 的摆动结构在**转折点上同样是事后确认**。
;   InpSwingStrength=2 意味着新的摆动低点要等右边再出 2 根K线才成立，
;   所以价格在底部反转那一刻，结构读出来仍然是"更低高点+更低低点"=做空，
;   于是一头撞进反弹里。比均线快，但没快到能抓住转折点。
;
;   补的这道闸门不预测方向，只否决一件事：
;   **要做空，可最近 5 根K线正在往上走（净幅超过 0.40×ATR）→ 不做。**
;   做多同理，正在跌就不做多。
;
;     InpCounterMoveBars = 5
;     InpCounterMoveATR  = 0.40   （默认 0.50，这一档收严）
;   日志里会写成：最近 5 根K线逆向走了 $x.xx（x.xx×ATR），不做空
;
;   ---- 方向改成看K线，不看均线 ----
;   InpDirectionMode=4。之前 1/2/3 三种模式读方向靠的都是 **EMA 交叉** ——
;   均线是平滑后的历史，转向必然滞后，所以 08-25 那种冲高回落里它会一路判多。
;   模式 4 读的是**摆动高低点**：
;     更高高点 + 更高低点 = 多      更低高点 + 更低低点 = 空
;   这是价格行为的原生语言，转向时反应快得多。
;   两级结构（M1 和 M5）都判不出方向时，退而看最近 6 根K线的净推进，
;   幅度要超过 0.30×ATR 才算有方向 —— 否则判为横盘，不做。
;
;   ⚠️ 现在质量过滤基本是关的（InpMinScore=2、InpAdxMin=0），
;      所以**方向判得准不准，就是这一档唯一的边**。这次改的正是那个地方。
;
;   ---- 为什么关掉了提前保本（实盘打脸的一条）----
;   实盘现象：连着几笔只赚 $0.11 / $0.17 / $0.21 / $0.24 / $0.37，
;   而点差成本就要 $0.15 —— 等于白干。
;
;   成因是两条规则互相打架：
;     InpBreakEvenUSD=2.0  赚到 $2 就把止损收到入场价附近（缓冲只有
;                          max(0.05xATR, 点差) ≈ $0.38~$0.51）
;     InpQuickProfitUSD=3.0 赚到 $3 才落袋
;   于是 $2 到 $3 这一段，单子背着一个 $0.4 的止损在走，而 ATR 是 5 ——
;   黄金随便一个回抽就打掉它。绝大多数单子在 $0.2 就被扫出去，到不了 $3。
;
;   结论：**出场是固定金额时，中途的保本止损是有害的。**
;   它不保护什么（真正的止损已经在那），只是在赢单路上多加一道随机的鬼门关，
;   把本该 +$3 的单子变成 +$0.2。
;
;     InpBreakEvenUSD 2.0 -> 0（关闭）
;     InpBreakEvenR   0.30 -> 0（= 跟随 InpTP1_R = 1.0R）
;   而 1R 恰好就是 $3 落袋那一刻（风险封顶 $3、目标 $3 = 1:1），
;   所以保本这道实际上永远不会先于落袋触发 —— 干净。
;
;   现在每笔只有两个结局：+$3 落袋，或 -$3 满止损。1:1，保本胜率 50%。
;
;   ---- 到手 $3 就落袋（含成本口径）----
;   InpQuickProfitUSD=3.0：净盈亏摸到 $3 立刻市价平仓。
;   "净"是真的净 —— PositionNetUSD() 用 POSITION_PROFIT（买单按 BID / 卖单按 ASK
;   计价，**点差已经扣在里面**）+ 隔夜利息 + 手续费x2。设 3.0 就是到手 $3。
;
;   InpRiskCapUSD=3.0 是**必须配套**的，不是可选项。盈亏比 = 目标 / 风险：
;       赚 $3 / 亏 $8（A+ 4%）= 1:0.38 -> 保本胜率要 72.7%
;       赚 $3 / 亏 $6（A  3%）= 1:0.50 -> 保本胜率要 66.7%
;       赚 $3 / 亏 $4（B  2%）= 1:0.75 -> 保本胜率要 57.1%
;       赚 $3 / 亏 $3（封顶后）= 1:1.00 -> 保本胜率要 50.0%
;   对照实测：$200 阶段胜率 60.5%，08-25 只有 35.5%。
;   不封顶风险的话，这条规则在 A/A+ 档上是**注定亏钱**的。
;   点差成本约占每笔风险的 8%（止损 $5、点差 $0.40 时），已含在上面的净额里。
;
;   风险封到 $3 = A+/A/B 分级在金额上被压平。这是刻意的：
;   出场是固定金额时，给好信号加大仓位只会让盈亏比更差（赢的还是 $3，亏的变多）。
;
;   关于"升到 $5 再跌回 $2-3 才关"：有了 $3 硬落袋，仓位根本到不了 $5 ——
;   这条按构造就不会发生，不需要单独再写一道规则。
;   唯一的例外是行情跳空直接穿过 $3，那种情况由 InpBreakEvenUSD=2.0 兜底
;   （到过 $2 就把止损推到保本，不会再变成亏损）。
;
;   ---- 方向本身有问题（用户指出，实盘证实）----
;   17:30~17:37 连开四张空单，全部打在 4603->4637 的反弹途中，全被扫掉。
;   面板：判多 10 / 判空 18，开多 0 / 开空 8 —— 它只会做空。
;
;   根子不在闸门，在 PriceActionDir 本身：
;   MarketStructure 回看 InpStructureLookback(60) 根找摆动高低点，
;   一波大跌之后它会在**几小时里一直读"向下"**，哪怕价格早已反弹回去。
;   再加多少道闸门，都是在给一个错的方向打补丁。
;
;   改法：方向必须由 **摆动结构** 与 **近期净推进** 两者共同确认。
;     两者一致  -> 按该方向做
;     两者分歧  -> **不做**（看不清就不做，而不是听结构的）
;     结构不明  -> 听近期推进
;     没有推进  -> 听结构
;   近期净推进改用 InpLTF(M5) 的 InpPaBars(6) 根 = 30 分钟窗口；
;   原来用 M1 的 6 根 = 6 分钟，一波一小时的行情在那个窗口里根本看不见。
;
;   逆势闸门同步升级为两级，并且窗口也改到 M5：
;     软阈值 InpCounterMoveATR=0.40      需配合"最新一根仍在继续"才否决
;                                        （否则会误杀趋势回调入场）
;     硬阈值 InpCounterMoveHardATR=0.80  逆向走得够远时无条件否决
;                                        （一小时的反弹不会因为出现一根阴线就变成回调）
;
;   ================================================================
;   ================================================================
;   ★ 换回按风险算手数（解决"一会儿一直亏一会儿不进场"）★
;   ================================================================
;   固定 0.01 手 + 大波动天生打架：放宽止损=冒钱多(危险)，收紧止损=拒单(没交易)。
;   按风险算(InpFixedLot=0)自动化解：止损宽 -> 手数自动缩 -> 大波动照样开单，
;   而每笔冒的钱恒定 = 风险%（2/3/4% = $4/$6/$8）。
;   固定$目标/$地板配变动手数不成立，换回 R 倍数：
;       止盈 2R（回测验证正期望）、+1R 移保本（"别让赢单变亏"的按比例版）。
;   止损上限放宽到 $12/1.2xATR —— 手数会自动缩，宽止损不再等于大风险。
;   ★ 这是这几天所有反复的总解药：入场稳、风险恒、赢跑亏砍。★
;   ================================================================
;
;   ---- 旧：固定手数那套（已改回，保留说明备查）----
;   ================================================================
;   ★ 出场就两条线（用户要求）★
;   ================================================================
;   InpTargetProfitUSD=10.0  设定的盈利位置：净赚 $10 就止盈。
;                            涨过 $4 后继续涨 -> 一路奔向 $10 自动平，不无限握。
;   InpProfitFloorUSD=4.0    利润地板：到过 $4 之后若跌回 $4 以下 -> 落袋 $4。
;
;   于是一张单只有三个结局：
;       +$10 止盈       (设定的盈利位置，涨到就走)
;       +$4  地板       (到过 $4 又回落，锁住 $4)
;       -止损 满亏      (没到过 $4 就反向)
;   都是净额（点差/手续费已扣）。固定 0.01 手时 $10 目标 = 金价走 $10。
;
;   为免出场逻辑打架，1R 保本、追踪、减仓全部关掉（InpBreakEvenR=0、
;   InpTP1_R=99）—— 就这两条线，干净。
;   ⚠️ 固定手数 + 固定 $ 目标：盈亏比随止损宽窄变（止损 $5 时 1:2，$8 时 1:1.25）。
;      止损已收窄到上限 $8，多数单在 1:1.5 以上。
;   ================================================================
;
;   ---- 利润地板 $4（原说明保留）----;   ---- 利润地板 $4（用户要求：超过 $4 继续拿，跌回 $4 才卖）----
;   InpProfitFloorUSD=4.0：净利**到过** $4 之后，只要跌回 $4 以下就落袋。
;   不砍上限 —— 超过 $4 继续涨就继续拿，2R 目标照样能吃到；只在回落时锁 $4。
;   和保本的分工：保本守入场价（$0），地板守 $4，地板更高、更早触发。
;   两条都只保护利润，不加风险，止损仍是唯一的亏损出口。
;   "净"已扣点差/手续费，设 4.0 就是到手 $4。
;
;   ---- 修「盈利了不放最后亏钱」（保本，不是砍上限）----
;   实盘：5 张空单入场 4608，价格先跌到 4596（每张浮盈 $12-14），
;   再弹回 4614，利润全吐光变满亏。成因是我昨天改 1:2 时把中途保护全关了，
;   赢单冲到 +1.9R 没摸到 2R 就能一路跌回 -1R，中间没东西拦。
;
;   解法是保本，不是「$4 就卖」——后者砍赢单上限，昨天已证明必亏。
;     InpBreakEvenR   2.0 -> 1.0   到 +1R 就把止损移到保本；之后再反转，
;                                  最坏在保本附近出场，而不是 -1R 满亏。
;                                  赢单仍能从 1R 跑到 2R，上限没被砍。
;   顺带修两个真隐患：
;     InpSlMaxUSD    15 -> 8       刚才那 $14 止损 = 账户 7%，太宽。拒掉宽单。
;     InpSlMaxATRMult 1.5 -> 0.8   止损上限向回测验证的 0.5xATR 靠拢，2R 才够得着
;     InpMaxPositions  8 -> 4      5~8 张同向单挤在一起，一个反弹全灭。降到 4。
;
;   ---- 固定手数 0.01（用户要求）----
;   InpFixedLot=0.01：每笔固定 0.01 手，不再按风险反算。
;   金价 4640 时 = 名义敞口 $4,640 = 本金的 23 倍杠杆，保证金约 $46。
;   每笔实际风险随止损宽窄变：止损 $4 冒 $4，$8 冒 $8，$15 冒 $15。
;   ⚠️ 这会打散 +2R/-1R 的等额结构 —— 宽止损单亏得多。[OPEN] 日志记实际风险。
;   想退回按风险算：属性页把 InpFixedLot 填 0。
;
;   ★ 方向不可预测，改赌赔率（基于 1021 笔真实回测）★
;   ================================================================
;   backtest_signals.py 在两年真实黄金上测了 14 种方向信号（结构、EMA、
;   突破、RSI、动量…顺做反做都测），**没有一个胜率站上 50%**。
;   结论：黄金 1h/M5 上方向就是不可预测的，我们改了 20 多轮方向逻辑全是白费。
;
;   但同一份回测的赔率表指出出路：同一个信号，
;       1:1 期望 -0.017  ->  1:2 期望 +0.027
;   只要**止损小、让赢单跑到亏单的两倍**，49% 的方向也能转正期望。
;   这就是黄金的本性：方向猜不准，但赢能走远、亏要砍快。
;
;   据此，这一档从"1:1 赚 $3 就走"彻底改成"1:2 让赢单跑"：
;       InpQuickProfitUSD  3 -> 0      去掉 $3 落袋（那是 1:1 的枷锁）
;       InpRiskCapUSD      3 -> 0      去掉 $3 风险封顶
;       InpTP2_R        1.8 -> 2.0     止盈 = 2 倍止损距离
;       InpSlMaxATRMult 3.0 -> 1.5     止损收窄，2R 才够得着
;       InpGiveBackPct   40 -> 0       2R 之前不许回吐平仓
;       Fade/Level/GiveBackMinR 全部 >= 2.0  一路不砍，让它跑到目标
;       InpPartialClosePct = 0         不半路减仓
;   方向仍用模式 4（结构+推进，回测里期望最稳的那个）。
;
;   现在每笔只有两个结局：+2R 止盈 或 -1R 满止损。赢是亏的两倍。
;   胜率只要不低于 34%（1/(1+2)）就是正期望 —— 而实测方向 49%，有余量。
;   $200 上：风险 2/3/4% = $4/$6/$8 止损，对应止盈 $8/$12/$16。
;
;   ⚠️ 这是第一个**有真实数据支撑**的方向。明天跑一个下午看：
;      赢单是不是真的能跑到 2R、平均每笔期望是不是正的。
;   ================================================================
;
;   ---- 08-25 实测：133 笔净 -$61.56，问题是赢单被砍在半路 ----;   ---- 08-25 实测：133 笔净 -$61.56，问题是赢单被砍在半路 ----
;   胜率 51.1%，看着接近平衡，但赢均 $1.03 / 亏均 $2.03 —— 盈亏比 0.51，
;   保本胜率要 66.4%。差的不是胜率，是**赢单太小**。
;
;   盈利分布把话说死了：
;       >= +$3    4 笔     <- $3 落袋几乎从没触发过
;       +$1~+3   18 笔
;       $0~+1    46 笔     <- 三分之二的"赢单"落在这里，点差都不够扣
;       -$1~-3   44 笔     <- 亏单基本吃满止损
;
;   风险封顶 $3、目标 $3，也就是 **1R = 落袋点**。那么任何在 1R 之前
;   动手的机制，都是在抢在落袋之前把单子砍掉。把它们全部推到落袋之后：
;     InpPartialClosePct  50 -> 0     部分止盈正好在 1R 砍掉一半仓位
;     InpTP1_R           1.0 -> 2.0   保本与追踪的启动点
;     InpFadeExitMinR    1.0 -> 2.0
;     InpGiveBackMinR    1.0 -> 2.0
;     InpLevelExitMinR   1.2 -> 2.0
;     InpExitOnMomentumFade true -> false
;   改完每笔只剩两个结局：+$3 落袋 或 -$3 满止损。
;
;   另外：做多 93 笔胜 48.4% 净 -$56.72，做空 40 笔胜 57.5% 净 -$4.84。
;   亏损集中在做多那一侧（当天金价整体在跌），方向模式 4 + 逆势闸门保留观察。
;
;   ---- 再放宽一轮（仍然没入场）----
;   先修了一个我自己造的冲突：逆势闸门会把**趋势回调**一起毙掉 ——
;   回调的定义就是最近几根K线在往反方向走，而入场 B 等的正是这一刻。
;   代码里补了条件：只有"最新一根还在继续往反方向走"才算逆势未结束；
;   最新一根已经掉头回到我这边 = 回调结束，放行。
;   这条大概率就是完全没单的原因。
;
;   然后把入场侧闸门再放一轮（逆势闸门、$3 落袋、风险封顶、方向模式 4 全部不动）：
;     InpMinScore / InpScoreMinB   4 -> 2
;     InpAdxMin                    9 -> 3
;     InpTriggerTolATR          0.90 -> 1.40
;     InpBarCloseStrength       0.30 -> 0.15
;     InpWickRejectPct          0.85 -> 0.95
;     InpAtrMinUSD              0.40 -> 0.15
;     InpMaxSpreadUSD           0.80 -> 1.20
;     InpUseNewsFilter          true -> false
;     InpSweepMinPenetration    0.05 -> 0.02
;     InpSlMaxATRMult            2.0 -> 3.0   少被"结构止损过宽"拒掉
;     InpMaxPositions              6 -> 8
;
;   ---- 追高保护改回 2.50（用户要求恢复入场量）----
;   上一轮为了"不要追高"把它从 2.50 收到 1.20，入场量就是被这一条砍掉的 ——
;   它是那两笔做空发生时的配置与现在唯一的**入场侧**差别。改回 2.50。
;   防追高的活现在交给逆势闸门（InpCounterMoveATR=0.40）：
;   前者管"离快线太远"，后者管"最近几根正在往反方向走" ——
;   后者更直接，也正是实盘打脸那两笔的成因。
;
;   ---- "已经赚了 $2 却变成亏损" 的修法 ----
;   实盘现象：单子到过 +$2，没落袋，最后按满止损离场。
;   成因是我上一轮把 InpFadeExitMinR / InpGiveBackMinR 从 0.45/0.60 抬到 1.00/1.00
;   （为了不让赢单被砍太早），结果 1R 以下完全没有任何保护动作 ——
;   而风险 $4~$8 的单子，$2 只有 0.25~0.5R，正好落在那个真空里。
;
;   新增 InpBreakEvenUSD=2.0：净赚到 $2 就把止损推到保本，**只移止损不平仓**。
;   于是"到过 $2 的单子不会再变成亏损"，同时它还能继续跑。
;   InpBreakEvenR 一并压到 0.30，两条是"或"的关系，谁先到算谁。
;
;   为什么不用 InpQuickProfitUSD（到 $2 直接平仓）：
;   风险 $4~$8 配 $2 止盈 = RR 1:0.25~0.5 -> 保本胜率要 67%~80%。
;   那是把盈亏比压死。真想那样做就把 InpQuickProfitUSD 设成 2.0，
;   但先看这一版的日志再决定。
;
;   ---- 杠杆：真正的旋钮是 InpRiskPct，不是 InpMaxMarginPctPerPos ----
;   账户杠杆 1:100 是券商给的，EA 改不了。EA 能控两样：
;     InpMaxMarginPctPerPos —— 单仓最多占用多少可用保证金
;     InpRiskPct*           —— 单笔冒多少钱，手数由它反算
;   实测：风险 1/1.5/2% 时保证金占用只有 $9~$93，而上限是 $160 ——
;   保证金那道闸门几乎从不触发。所以调它没用，调风险才有用。
;
;     InpRiskPct B/A/A+   1.0/1.5/2.0 -> 2.0/3.0/4.0   ($4/$6/$8 每笔)
;     InpRiskPctMax               2.0 -> 4.0
;     InpMaxCombinedRiskPct        20% -> 30%（$60 同时在险）
;     InpMaxMarginPctPerPos        80% -> 95%（顺手抬开，让它彻底不当瓶颈）
;
;   $200 上的实际杠杆（金价 4665，1 手 = 100oz）：
;     止损 $2  -> 47~93 倍     止损 $5  -> 19~37 倍     止损 $10 -> 9~19 倍
;   止损越窄手数越大，杠杆越高 —— M1 触发下止损普遍偏窄，所以实际会落在偏高那端。
;
;   ⚠️ 日亏上限 60% = $120，每笔 $4~$8 -> 15~30 笔亏光当日额度。
;
;   ---- 当前档位（用户要求：改回过滤 + 看K线定方向 + 连亏熔断关掉）----
;   质量过滤改回来了（上一轮"最激进"那版把过滤全关，等于任何形态都开，
;   净值当然往下走）：
;     InpMinScore / InpScoreMinB  2 -> 4
;     InpAdxMin           0 -> 9
;     InpTriggerTolATR 1.50 -> 0.90
;     InpBarCloseStrength 0.10 -> 0.30
;     InpWickRejectPct 0.98 -> 0.85
;     InpLooseMaxDistATR 5.00 -> 2.50
;     InpMinRR 0.30 -> 1.0、InpAtrMinUSD 0.10 -> 0.40
;     InpMaxSpreadUSD 1.50 -> 0.80、InpUseNewsFilter 恢复 true
;     InpSlMaxATRMult 3.0 -> 2.0
;
;   连亏熔断关掉：
;     InpStopAfterConsecLoss    = 0
;     InpObserveAfterConsecLoss = 0
;   （代码里已把 <=0 显式当"关闭"处理。不能只把数字填 0 就算完 ——
;     判断是 consecLoss >= 阈值，阈值 0 时恒真，会变成开局就永久停手。）
;
;   激进保留：M1 触发、方向模式 4、每日 200 笔、同时 6 仓、组合在险 20%、
;   风险 1/1.5/2%、日亏上限 60%（$120）。
;
;   现在唯一还会让它当天收工的是**日亏 $120** 和 **日目标 $120**。
;
;   ---- 最激进档（用户要求：改得最激进）----
;   入场侧闸门全部推到最松，只保留硬红线（必带止损、只跑 Demo、不马丁）：
;     InpDirectionMode      2 -> 3     M5 定方向，不再等 H1 表态
;     InpHtfRequire*     true -> false H1 不再要求收盘站位/斜率
;     InpMinScore/ScoreMinB 4 -> 2     触发本身占 2 分，等于评分过滤关掉
;     InpAdxMin             7 -> 0     横盘也做
;     InpTriggerTolATR   0.60 -> 1.50  回踩容差
;     InpBarCloseStrength 0.45 -> 0.10 收盘强度几乎不要求
;     InpWickRejectPct   0.70 -> 0.98  影线否决基本关掉
;     InpLooseMaxDistATR 2.50 -> 5.00  追高保护基本关掉
;     InpMinRR            1.0 -> 0.3
;     InpAtrMinUSD       0.40 -> 0.10  低波动也做
;     InpMaxSpreadUSD    0.80 -> 1.50
;     InpUseNewsFilter   true -> false 新闻封锁取消
;     InpSlMaxATRMult     2.0 -> 3.0   少被结构止损过宽拒掉
;     每日 200 笔 / 同时 8 仓 / 组合在险 20%
;
;   ⚠️ 这一档等于没有质量过滤。用途只有一个：把成交量堆起来看日志。
;      净值大概率往下走，别拿它当策略。
;
;   ---- 调策略：出场不对称才是亏钱的原因 ----
;   08-25 实测：赢单金价只走 +$3.88（0.4xATR），亏单走 -$11.23（1.2xATR）。
;   比值 0.35 -> 保本胜率要 74%。**赢单被砍太早，亏单放到满止损**，方向正好反了。
;   两头一起收：
;     InpFadeExitMinR   0.45 -> 1.00   动量衰竭离场不许在 1R 之前砍赢单
;     InpGiveBackMinR   0.60 -> 1.00   回吐上限同样等到 1R 之后才开始管
;     InpSlMaxATRMult   3.0  -> 2.0    止损上限 3xATR -> 2xATR（ATR 9.5 时 $28 -> $19）
;   保本仍在 0.5R —— 那个是把亏损截到 0，不是砍赢单，不动。
;
;   ---- 出单量：像 $10k 那时一样一直有单 ----
;     InpEntryTF        M5 -> M1      确认延迟 5 分钟 -> 1 分钟
;     InpAdxMin          9 -> 7
;     InpLooseMaxDistATR 1.80 -> 2.50
;
;   （更正一条先前写错的：08-24 那批 $0.5~0.9 的止损是**平仓时**的止损，
;     已被保本移动过，不是开仓止损。不能据此说 M1 触发会产生垃圾止损 ——
;     开仓止损有 InpSlMinUSD=1.20 兜底。）
;
;   ---- 跑满一天：把两边的早停都挪开 ----
;   目的是拿到一整天的样本，所以能提前收工的闸门全部抬高：
;     日亏上限 30% -> 60%  ($60 -> $120)  = 30 笔 x $4，正好让连亏 30 成为先到的那道
;     日目标   25% -> 60%  ($50 -> $120)  赚到 $50 就收工的话同样跑不满一天
;     保守档   10% -> 30%  ($20 -> $60)   原来一赚 $20 就收紧过滤，样本被掐掉
;     收紧档   15% -> 45%  ($30 -> $90)
;
;   ⚠️ 直说：日亏 $120 = 一天可以亏掉本金的 60%。这是**采样设定**，
;      不是能长期跑的配置。拿到日志分析完就把这几个数调回来。
;
;   ---- 唯一一处不照抄旧档的地方 ----
;   InpBreakEvenR=0.50 / InpGiveBackPct=40（旧档是 0 / 0）
;   旧档保本绑在 1.0R：走到 +0.9R 再掉头 = 全额 -1.0R，一次 1.9R 的净摆动，
;   两三笔抵消掉一整天。这两条修的是那个毛病，不改打法本身。
;   想 100% 复刻旧档：属性页把这两个改回 0。
;
;   ---- 做空是怎么加回来的 ----
;   原 aggressive 档结构性地做不了空，两条撞在一起：
;     · InpHtfRequireCloseSide / InpHtfRequireSlope 都关着，HtfTrend() 退化成
;       纯粹的 "H1 EMA50 vs EMA200"，牛市里连续几周不翻面 —— H1 恒为 +1。
;     · InpDirectionMode=1 又让方向完全等于 H1。
;   两条合起来：方向恒定为多。当初 31 笔 100% BUY 就是这么来的，不是市场，
;   也不是 bug，是这两个开关的交互 —— 而且它不报错、不留痕迹。
;
;   修法（改动尽量小，不动打法本身）：
;     · 两个 H1 附加条件打开 —— H1 不再只看两条均线谁上谁下，还要求收盘价
;       站在快线正确一侧、且快线本身仍在同向移动。趋势中途回踩时 H1 会诚实地
;       回到**中性**，而不是死撑着报 +1。
;     · InpDirectionMode=2 —— H1 有方向就听 H1（跟大趋势，和旧打法一致）；
;       **H1 中性时才交给 M5 定方向**，做空正是在这时候出现。
;
;   为什么不用模式 3（M5 直接定方向）：那会在 H1 明确上涨时也照做空，
;   变成无差别逆势。模式 2 只在"H1 自己也没底气"时才放手，更接近旧打法的性格。
;   本档 InpAdxMin=12 比 sim200 的 5 严得多，横盘期两边乱打的风险也小。
;
;   ⚠️ 代价：H1 附加条件打开后，H1 报出方向的时间变少，
;      纯粹"跟大趋势"的多单会比原 aggressive 档少一些。
;      换来的是做空这条路真的能走。
;
;   面板「方向(挂载以来)」那一行会直接显示 判多/判空、开多/开空 的笔数 ——
;   挂上去半小时看那一行，比猜有没有做空快得多。
;
;   ⚠️ InpBreakEvenR=0（旧行为）：保本和 TP1 绑在 1.0R，到不了 1.0R 止损就不动。
;      "明明盈利着最后亏钱"就是这么来的。想只修这一条而别的都保持旧样：
;      EA 属性页把 InpBreakEvenR 改成 0.50 即可，不用重装也不用重编译。
; ============================================================================


; --- 安全闸门：保持只跑 Demo ---
InpAllowLiveAccount=false

; --- 日内限额：按 $10,000 余额换算，否则一笔亏损就收工 ---
; --- A 档：日亏上限 $200，单笔风险随之降到 0.5% ---
; $9934 的 2% ≈ $199。单笔 $50 -> 能扛 4 笔亏损才收工(原 1.5% 只能扛 1.3 笔)。
; 仓位变小不影响统计性质:R 倍数与手数无关,同样的钱能跑出 3 倍的样本量。
InpFixedLot=0.01
InpClampWideStop=true
InpProfitFloorUSD=8.0
InpRiskPctDefault=2.0
; 硬上限跟着降到 1.0 —— 让"任何路径都不得超过"这句话反映真实意图,
; 而不是留一个谁也够不到的 5%。
InpRiskPctMax=4.0
InpDailyProfitTarget=2500.0
InpDailyMaxLoss=750.0
InpConservativeAt=1000.0
InpReducedAt=1500.0

; --- 放宽停手条件：采样期要的是笔数 ---
InpMaxTradesPerDay=100000
InpStopAfterConsecLoss=0
InpObserveAfterConsecLoss=0

; --- 时段：全天开放（原 8-21 是按 GMT+0 写的，全开就不用先解决时区问题）---
InpSessionStartHour=0
InpSessionEndHour=23
InpFlatAllBeforeHour=23

; --- 点差：这是你当前的直接拦路虎（实测 0.40，原上限 0.35）---
; 0.60 / 0.25 会让亚洲盘也能过。代价明确：$0.40 点差配 $3 止损 = 每笔先付掉
; 13% 的风险额度。采样期接受，评估期必须把这笔成本从结果里扣回去。
InpMaxSpreadUSD=1.20
InpSpreadVsATRMax=0.25

; --- M5 趋势判定：只看均线排列，不要求收盘价站在慢线一侧 ---
; 实测拦路的是 "趋势不一致 HTF=1 LTF=0"：EMA20>EMA50(结构仍多头)但收盘跌破
; EMA50 时 LtfTrend 返回 0。而那正是入场 B(趋势回调)想要的位置 —— 等于这个
; 策略的回调入场被它自己的趋势过滤挡住了。
InpLtfRequireCloseSide=false
; H1 原本要三条同时成立:快线>慢线、收盘>快线、快线仍在同向移动。
; 实测拦路的是 "趋势不一致 HTF=0" —— 缺任何一条 H1 就判无趋势,信号在第一步被毙。
; 采样期只保留"快线>慢线"这一条,后两条关掉。
InpHtfRequireCloseSide=false
InpHtfRequireSlope=false

; --- 信号门槛 ---
; InpMinScore=4 实际等于关掉评分过滤：触发本身占 2 分，而 HTF/LTF 同向是
; 出信号的前提、必得 2 分，所以任何有效信号的分数天然 >= 4。
InpMinScore=2
InpEntryTF=1
InpAdxMin=3.0
InpMinRR=0.5
InpBreakoutLookback=20

; --- 入场触发灵敏度(实测最常见的拒绝原因就是"无有效突破/回踩触发")---
; tol 放宽 = 回踩不必那么精准就算数;收盘位置与影线要求同步放松。
InpTriggerTolATR=1.40
InpBarCloseStrength=0.15
InpWickRejectPct=0.95

; --- 关键位压缩止盈:忽略近于 1.2R 的关键位 ---
; 实测出现过 RR=0.04 的拒绝 —— M5 上贴着入场价的小摆动高点被当成硬顶。
; 那不是阻力是噪音,价格照穿。设 0 = 恢复原来"取最近的"行为。
InpLevelIgnoreR=1.20

; --- 波动率区间：放宽两头，别在安静时段直接哑火 ---
InpAtrMinUSD=0.15
InpAtrMaxUSD=15.00

; --- 止损区间 ---
InpSlMinUSD=1.20
; 实测出现过 "结构止损过宽 10.01 > 8.00" 的拒绝。ATR 3.38 时摆动点本来就可能
; 离入场 10 美元。$10,000 账户下 1% = $100,$10 止损只需 0.1 手,风险完全够用。
InpSlMaxUSD=10.0
; 实测 ATR 从 3.38 涨到 7.04 后出现 "结构止损过宽 17.83 > 15.00" —— 固定上限
; 是按低波动定的,必须跟着 ATR 走。3×ATR 在 ATR=7 时是 21,接得住。
InpSlMaxATRMult=0.0

; --- 市场质量闸门：不否决，但照样计算并随每笔成交记录 ---
; 这是这一档里最重要的一行。关掉否决 = 拿到样本；保留记录 = 事后能回答
; 「在高频假突破/横盘的行情里做的单，表现是不是真的更差」。
; 直接删掉这个闸门的话，这个问题永远没有答案。
InpUseMarketQuality=false
InpMinRangeATR=2.5
InpMaxSmallBodyPct=70.0
InpMaxFakeBreakouts=5

; --- 持仓管理：维持原样，这些不是"过滤器"，是出场逻辑 ---
; 这里把出场参数**全部列全**（哪怕等于代码默认值）。
; .set 只会覆盖它列出的项 —— 少列一个，从 scalp 档切回来时那一项就还留着
; 快出的值，A/B 对比直接被污染。两档必须互为完整快照。
InpMaxHoldMinutes=180
InpExitOnMomentumFade=false
InpTP1_R=99.0
InpTP2_R=2.0
InpPartialClosePct=0.0
InpBreakevenBufferATR=0.05
InpBreakEvenR=0.0
InpBreakEvenUSD=0.0
InpGiveBackPct=0.0
InpGiveBackMinR=2.0
InpTrailATRMult=1.0
InpFadeExitMinR=2.0
; 实测:11/18 笔出场是"逼近关键位提前平仓",R 密集落在 0.70~0.82(阈值本身),
; 而计划 RR 均值 1.67 —— 只拿到计划的 48%。原因是该出场把任何 M5 微型摆动点
; 都当关键位,趋势里条件恒真。抬门槛 + 只认机构参考位。
InpLevelExitMinR=2.0
InpLevelExitKeyOnly=true
InpExitOnStall=false
InpStallMinutes=10
InpStallRangeATR=0.25
InpStallMinUSD=0.0
InpStallMinR=0.50
InpStallNeedNoNewExtreme=true

; --- 新闻过滤：保留 ---
; 数据前后 30/20 分钟本来就没多少交易时间，但那几分钟的滑点能毁掉一整天的
; 样本质量。采样期留着，让样本干净。
InpUseNewsFilter=false

; --- 机构参考位 + 扫损反手（见 GOLD_PRO_TECHNIQUES.md）---
; 前日高低/亚洲区间/整数关口:客观可算,不需人工标注。
; 亚洲盘窗口用**服务器时间**:UTC+3 下 UTC 00:00-07:00 = 服务器 03:00-10:00。
InpUseKeyLevels=true
InpUseRoundNumbers=true
InpRoundStep=50.0
InpAsiaStartHour=3
InpAsiaEndHour=10
; 刺穿深度的上下限是关键:没有上限的话,任何真突破都会被误判成扫损,
; 然后就在趋势反方向反复接刀。
InpUseSweepEntry=true
InpSweepMinPenetration=0.02
InpSweepMaxPenetration=1.50

; --- 固定金额目标（默认关闭）---
; InpTargetProfitUSD > 0 = 止盈直接摆在"赚到这个金额"的价位,不再按 R 倍数。
; 必须和 InpRiskCapUSD 配套,否则是陷阱:
;   风险 $100 + 目标 $10 = RR 1:0.10 -> 保本胜率 90.9%
;   风险 $10  + 目标 $10 = RR 1:1.00 -> 保本胜率 50.0%
;   风险 $5   + 目标 $10 = RR 1:2.00 -> 保本胜率 33.3%
; 想用就把两个一起改,OnInit 会把 RR 和保本胜率算给你看。
InpTargetProfitUSD=13.0
InpRiskCapUSD=0.0
InpQuickProfitUSD=0.0
; 0 = 用真实余额算百分比(见 sim200 档)
InpVirtualBalanceUSD=200.0

; --- V2 评分与分级（规格 §28/§29）---
; 风险由 setup 质量给,不由"想赚多少"给。C 级(<5分)一律 NO TRADE。
InpUseV2Scoring=true
; 采样期降到 4:10 分制是新加的一道闸门,非扫损路径的流动性维度本就拿不满,
; 门槛留在 5 会把大量合格 setup 判成 C 级。等有样本了再按实测分数分布调回来。
InpScoreMinB=2
InpScoreMinA=7
InpScoreMinAPlus=9
InpRiskPctB=2.0
InpRiskPctA=3.0
InpRiskPctAPlus=4.0

; --- V2 结构位移 ---
; ⚠️ BOS/CHoCH 用的是代码里写死的机械定义,不是权威定义。见文件头注释。
InpUseBOS=true
InpBosBufferATR=0.05
InpRequireMtfAgree=false

; --- V2 波动率分档（规格 §13）---
; 用 ATR/自身均值 的比值,不用绝对数 —— 金价从 $2000 到 $4400,绝对 ATR 早就变了。
InpUseVolRegime=true
InpAtrAvgPeriod=96
InpVolHighMult=1.60
InpVolExtremeMult=2.40
InpVolHighSizeMult=0.60

; --- V2 日内限额改百分比（规格 §21/§23）---
; 规格的 +$50/-$30 是按 $200 写的。用百分比后同一份规格在任何余额上语义一致。
InpDailyTargetPct=60.0
InpDailyMaxLossPct=60.0
InpConservativeAtPct=30.0
InpReducedAtPct=45.0

; --- 多仓并行（规格 §30）---
; 加仓 = 往同一笔盈利单上追;多仓 = 各自独立的 setup + 各自独立止损。
; 真正该守的不是"只能一笔",而是**总在险金额上限**。
; 已移到保本之外的仓位按 0 计入在险 —— 那些确实没有敞口了。
InpAllowMultiPosition=true
InpMaxPositions=4
InpMaxCombinedRiskPct=30.0
InpMaxMarginPctPerPos=95.0
; 规格 §31:反向开仓是在掩盖错误,不是管理风险。保持禁止。
InpAllowHedge=false

; --- 宽松入场 路径D（采样用）---
; "无有效突破/回踩触发"长期是第一大拒绝原因。这条路径只要求顺势收盘 +
; 价格没过度偏离快线(防 FOMO 追高)。
; ⚠️ 它一定会拉低平均质量。单独标记路径,事后按路径分组比期望值,亏就关掉。
InpUseLooseEntry=true
InpLooseMaxDistATR=2.50

; --- 方向判定与冲突处理（本轮最关键的一项）---
; 实测拦路 "趋势不一致 HTF=1 LTF=-1" —— 两周期方向明确但相反,那正是**回调**。
; 而入场 B 就叫"趋势回调",它等的就是这一刻。要求两周期同向 = 把自己的回调
; 入场毙掉;「结构冲突」「动量冲突」同理,回调时必然冲突。
; 1 = H1 定方向,M5 只影响评分不否决
InpDirectionMode=4
; false = 冲突不否决,只写进成交备注,由 10 分制评分反映质量差异。
; 事后可按"有无冲突"分组比期望值 —— 若带冲突的单确实更差,再改回 true。
InpConflictAsVeto=false
InpInvertSignals=false
InpTrendVeto=true
InpTrendBars=4
InpTrendMinUSD=5.0
InpCounterMoveBars=6
InpCounterMoveATR=0.40
InpCounterMoveHardATR=0.80
InpPaBars=6
InpPaMinATR=0.30

; --- 新闻事件窗口（fomc 档会覆盖这几项）---
; 全部列全,否则从 fomc 档切回来时这几项会残留 —— .set 只覆盖它列出的项。
InpNewsBeforeMin=30
InpNewsAfterMin=20
InpManualNewsTimes=
; >0 = 重大数据前 N 分钟强制清仓。原新闻过滤只挡新开仓,已持仓会毫无保护
; 穿过事件 —— 跳空时止损不保证成交价。平时 0,事件日用 fomc 档。
InpFlatBeforeNewsMin=0

; --- 监控 ---
InpPushNotify=true
InpWriteStatusJson=true
InpVerboseLog=true

InpTesterQuiet=true
InpUseCommandFile=false
InpCommandMaxAgeMin=15
