; ============================================================================
; XAUUSD ScalperGuard —— $200 本金 · 快进场激进档
;
; 用 InpVirtualBalanceUSD=200：所有按百分比算的东西都以 $200 为基准，
; 而不是终端里的真实余额。保证金检查不受影响 —— 那是券商的真实约束。
;
; ---- 核心：把"进场太慢"拆成两件事，分别修 ----
;
; 1) 慢在**等K线收盘**。原来触发根是 M5：一个形态最长要等 5 分钟才被确认，
;    行情早走完了。这一档 InpEntryTF=1（M1），确认延迟降到 1 分钟，快 5 倍。
;    ⚠️ 换掉的只是"扣扳机的那根K线"。方向仍由 H1 EMA 决定，ATR / ADX /
;       市场结构 / 关键位 全部还在 M5 和 H1 上算 —— 不是把策略搬到 M1。
;    止损也跟着 M1 结构走（否则会出现"M1 进场却背 M5 宽止损"的错配），
;    过窄时由 InpSlMinUSD=1.20 和券商最小距离兜底。
;
; 2) 慢在**过滤太严**。逐条放宽，做多做空对称：
;      InpDirectionMode  1 -> 2    H1 无方向时退而用 M5，不再整段时间不出手
;      InpAdxMin        12 -> 8    ADX 门槛；黄金震荡段 ADX 常年在 10 附近
;      InpTriggerTolATR 0.60->0.90 回踩容差；不必精确摸到位才算数
;      InpBarCloseStrength 0.45->0.30  确认K线收盘强度
;      InpWickRejectPct 0.70->0.85 影线否决更难触发（M1 影线占比天然更大）
;      InpSweepMinPenetration 0.10->0.05  M1 的刺穿本来就浅
;
; ---- 出场：回到 R 倍数 ----
;   固定金额快速离场已关闭（InpQuickProfitUSD=0 / InpRiskCapUSD=0），
;   A+/A/B 的风险分级恢复：$3 / $6 / $10。
;
; ---- 日内节奏 ----
;   日目标 50% = $100    日亏上限 50% = $100（两边对称）
;   每日上限 80 笔       连亏 8 笔停手 / 连亏 5 笔进观察模式
;
; ---- 做空为什么一直没发生（模式 3 就是修这个）----
;   代码里多空两条路完全对称，查过：趋势判定、结构、动量、关键位、扫损、
;   止损、止盈、RR —— 没有一处偏袒做多。
;   真正的原因是两个设置撞在一起：
;     · InpHtfRequireCloseSide / InpHtfRequireSlope 都关掉之后，
;       HtfTrend() 退化成纯粹的 "H1 EMA50 vs EMA200"，一段趋势里能连续
;       几周不翻面 —— H1 几乎永远不中性。
;     · 而模式 2 只在 **H1 完全中性** 时才轮到 M5 定方向。
;   两条合起来 = 方向恒定为一边，模式 2 名义上"任一周期有方向即可"，
;   实际等同模式 1。31 笔实盘 100% 是 BUY，就是这么来的。
;
;   InpDirectionMode=3：M5 定方向，H1 只进评分不定方向。做空立刻活过来。
;   逆着 H1 的单子不需要特殊处理 —— 10 分制的 trend 维度自然少给 1~2 分，
;   等级降下来风险上限跟着降，仓位自动变小。
;
;   面板新增一行「方向(挂载以来)」，直接显示判多/判空、开多/开空的笔数。
;   再出现 100% 单边，一眼就能看见，不用等 31 笔之后才发现。
;
; ---- 激进档 v2：第二轮放宽 ----
;   InpLooseMaxDistATR 1.20 -> 3.00   追高保护放到 3×ATR
;   InpAdxMin           8.0 -> 5.0
;   InpMinScore / InpScoreMinB  4 -> 3
;   InpTriggerTolATR   0.90 -> 1.30   回踩容差
;   InpBarCloseStrength 0.30 -> 0.20
;   InpWickRejectPct   0.85 -> 0.92   影线否决更难触发
;   InpMaxPositions       3 -> 5      同时持仓数
;   InpMaxCombinedRiskPct 10 -> 15    组合在险上限（$200 基准 = $30）
;   InpSlMaxATRMult     3.0 -> 4.0    容许更宽的结构止损
;
;   没动的：保本 0.5R、回吐上限 40%、M1 触发、A+/A/B 分级、日目标/日亏上限、
;   单笔风险上限 5%、只跑 Demo 的闸门。
;   放宽的是"进不进场"，不是"一笔能亏多少" —— 每笔仍然必带止损，
;   止损宽了手数自动变小，单笔风险百分比不变。
;
;   ⚠️ InpLooseMaxDistATR=3.00 的实际含义：ATR≈6.3 时，
;      允许在偏离 M5 快线 $19 的位置顺势进场。这就是追高，代价心里要有数。
;
; ---- 守住利润：这一档真正在解决的问题 ----
;   症状：进场后明明盈利着，磨一阵之后掉头，最后按 -1R 全额止损离场。
;   一笔走到 +0.9R 再回到 -1.0R，是一次 **1.9R 的净摆动**，两三笔就抵消掉
;   一整天的赢单。原因是保本和 TP1 绑死在 1.0R —— 到不了 1.0R，止损就从没动过。
;
;   InpBreakEvenR=0.50   到半个止损距离就把止损推到保本，不再等 1.0R。
;                        保本缓冲代码里已强制 >= 当前点差，否则"保本"仍是净亏。
;   InpGiveBackPct=40    守的是**曾经到过的最高点**，不是入场价：
;                        冲到 +1.5R 再退回，跌破 +0.9R 就收手。
;   InpGiveBackMinR=0.60 最高盈利没到 0.6R 之前，回吐上限不生效
;                        （否则刚进场的正常波动就会被当成回吐）。
;
;   ⚠️ 代价是真的：保本前移会让一部分"本来会成"的单子在 0 附近被扫出去。
;      黄金回踩到入场价再启动是常态。这一刀砍掉的是大亏，同时也砍掉一些赢单。
;
; ---- 停滞离场（已关闭）----
;   有利润($2 净额)且最近 10 分钟高低差 < ATR × 0.80 -> 落袋。
;   k=0.80 不是拍的：reports/gold_stall.md 实测 10 分钟窗口的 10% 分位就是 0.80。
;   （第一版我拍了 0.60，实测命中率 0.0% —— 那是死代码，不是保守。）
;   只砍"不走了"的单子；还在创有利极值的不动，所以趋势单不受影响。
;
; ⚠️ M1 触发 = 信号数量大增，其中噪音也大增。这一档没有被回测验证过，
;    先小量观察，重点看日志里 [OPEN] 的多空比例：如果仍然几乎全是 BUY，
;    那问题不在"慢"，在方向判定，得另外查。
; ============================================================================




; --- 安全闸门：保持只跑 Demo ---
InpAllowLiveAccount=false

; --- 日内限额：以虚拟本金 $200 为基准（目标 +$100 / 上限 -$100）---
; --- A 档：日亏上限 $200，单笔风险随之降到 0.5% ---
; $9934 的 2% ≈ $199。单笔 $50 -> 能扛 4 笔亏损才收工(原 1.5% 只能扛 1.3 笔)。
; 仓位变小不影响统计性质:R 倍数与手数无关,同样的钱能跑出 3 倍的样本量。
InpFixedLot=0.0
InpClampWideStop=false
InpEntryMode=0
InpVwapTouchATR=0.50
InpEntryCooldownSec=0
InpProfitFloorUSD=0.0
InpRiskPctDefault=1.0
; 硬上限跟着降到 1.0 —— 让"任何路径都不得超过"这句话反映真实意图,
; 而不是留一个谁也够不到的 5%。
InpRiskPctMax=5.0
InpDailyProfitTarget=50.0
InpDailyMaxLoss=30.0
InpConservativeAt=20.0
InpReducedAt=30.0

; --- 放宽停手条件：采样期要的是笔数 ---
InpMaxTradesPerDay=80
InpStopAfterConsecLoss=20
InpObserveAfterConsecLoss=5

; --- 时段：全天开放（原 8-21 是按 GMT+0 写的，全开就不用先解决时区问题）---
InpSessionStartHour=0
InpSessionEndHour=23
InpFlatAllBeforeHour=23

; --- 点差：这是你当前的直接拦路虎（实测 0.40，原上限 0.35）---
; 0.60 / 0.25 会让亚洲盘也能过。代价明确：$0.40 点差配 $3 止损 = 每笔先付掉
; 13% 的风险额度。采样期接受，评估期必须把这笔成本从结果里扣回去。
InpMaxSpreadUSD=0.80
InpSpreadVsATRMax=0.25

; --- M5 趋势判定：只看均线排列，不要求收盘价站在慢线一侧 ---
; 实测拦路的是 "趋势不一致 HTF=1 LTF=0"：EMA20>EMA50(结构仍多头)但收盘跌破
; EMA50 时 LtfTrend 返回 0。而那正是入场 B(趋势回调)想要的位置 —— 等于这个
; 策略的回调入场被它自己的趋势过滤挡住了。
InpLtfRequireCloseSide=false
; H1 原本要三条同时成立:快线>慢线、收盘>快线、快线仍在同向移动。
; 实测拦路的是 "趋势不一致 HTF=0" —— 缺任何一条 H1 就判无趋势,信号在第一步被毙。
; 采样期只保留"快线>慢线"这一条,后两条关掉。
InpHtfRequireCloseSide=false
InpHtfRequireSlope=false

; --- 信号门槛 ---
; InpMinScore=4 实际等于关掉评分过滤：触发本身占 2 分，而 HTF/LTF 同向是
; 出信号的前提、必得 2 分，所以任何有效信号的分数天然 >= 4。
InpMinScore=3
InpEntryTF=1
InpAdxMin=5.0
InpMinRR=1.0
InpBreakoutLookback=20

; --- 入场触发灵敏度(实测最常见的拒绝原因就是"无有效突破/回踩触发")---
; tol 放宽 = 回踩不必那么精准就算数;收盘位置与影线要求同步放松。
InpTriggerTolATR=1.30
InpBarCloseStrength=0.20
InpWickRejectPct=0.92

; --- 关键位压缩止盈:忽略近于 1.2R 的关键位 ---
; 实测出现过 RR=0.04 的拒绝 —— M5 上贴着入场价的小摆动高点被当成硬顶。
; 那不是阻力是噪音,价格照穿。设 0 = 恢复原来"取最近的"行为。
InpLevelIgnoreR=1.20

; --- 波动率区间：放宽两头，别在安静时段直接哑火 ---
InpAtrMinUSD=0.40
InpAtrMaxUSD=15.00

; --- 止损区间 ---
InpSlMinUSD=1.20
; 实测出现过 "结构止损过宽 10.01 > 8.00" 的拒绝。ATR 3.38 时摆动点本来就可能
; 离入场 10 美元。$10,000 账户下 1% = $100,$10 止损只需 0.1 手,风险完全够用。
InpSlMaxUSD=15.00
; 实测 ATR 从 3.38 涨到 7.04 后出现 "结构止损过宽 17.83 > 15.00" —— 固定上限
; 是按低波动定的,必须跟着 ATR 走。3×ATR 在 ATR=7 时是 21,接得住。
InpSlMaxATRMult=4.0

; --- 市场质量闸门：不否决，但照样计算并随每笔成交记录 ---
; 这是这一档里最重要的一行。关掉否决 = 拿到样本；保留记录 = 事后能回答
; 「在高频假突破/横盘的行情里做的单，表现是不是真的更差」。
; 直接删掉这个闸门的话，这个问题永远没有答案。
InpUseMarketQuality=false
InpMinRangeATR=2.5
InpMaxSmallBodyPct=70.0
InpMaxFakeBreakouts=5

; --- 持仓管理：维持原样，这些不是"过滤器"，是出场逻辑 ---
; 这里把出场参数**全部列全**（哪怕等于代码默认值）。
; .set 只会覆盖它列出的项 —— 少列一个，从 scalp 档切回来时那一项就还留着
; 快出的值，A/B 对比直接被污染。两档必须互为完整快照。
InpMaxHoldMinutes=180
InpExitOnMomentumFade=true
InpTP1_R=1.0
InpTP2_R=1.8
InpPartialClosePct=50.0
InpBreakevenBufferATR=0.05
InpBreakEvenR=0.50
InpBreakEvenUSD=0.0
InpGiveBackPct=40.0
InpGiveBackMinR=0.60
InpTrailATRMult=1.0
InpFadeExitMinR=0.45
; 实测:11/18 笔出场是"逼近关键位提前平仓",R 密集落在 0.70~0.82(阈值本身),
; 而计划 RR 均值 1.67 —— 只拿到计划的 48%。原因是该出场把任何 M5 微型摆动点
; 都当关键位,趋势里条件恒真。抬门槛 + 只认机构参考位。
InpLevelExitMinR=1.20
InpLevelExitKeyOnly=true
InpExitOnStall=false
InpStallMinutes=10
InpStallRangeATR=0.80
InpStallMinUSD=2.0
InpStallMinR=0.50
InpStallNeedNoNewExtreme=true

; --- 新闻过滤：保留 ---
; 数据前后 30/20 分钟本来就没多少交易时间，但那几分钟的滑点能毁掉一整天的
; 样本质量。采样期留着，让样本干净。
InpUseNewsFilter=true

; --- 机构参考位 + 扫损反手（见 GOLD_PRO_TECHNIQUES.md）---
; 前日高低/亚洲区间/整数关口:客观可算,不需人工标注。
; 亚洲盘窗口用**服务器时间**:UTC+3 下 UTC 00:00-07:00 = 服务器 03:00-10:00。
InpUseKeyLevels=true
InpUseRoundNumbers=true
InpRoundStep=50.0
InpAsiaStartHour=3
InpAsiaEndHour=10
; 刺穿深度的上下限是关键:没有上限的话,任何真突破都会被误判成扫损,
; 然后就在趋势反方向反复接刀。
InpUseSweepEntry=true
InpSweepMinPenetration=0.05
InpSweepMaxPenetration=1.50

; --- 固定金额目标（默认关闭）---
; InpTargetProfitUSD > 0 = 止盈直接摆在"赚到这个金额"的价位,不再按 R 倍数。
; 必须和 InpRiskCapUSD 配套,否则是陷阱:
;   风险 $100 + 目标 $10 = RR 1:0.10 -> 保本胜率 90.9%
;   风险 $10  + 目标 $10 = RR 1:1.00 -> 保本胜率 50.0%
;   风险 $5   + 目标 $10 = RR 1:2.00 -> 保本胜率 33.3%
; 想用就把两个一起改,OnInit 会把 RR 和保本胜率算给你看。
InpTargetProfitUSD=0.0
; 分级交给百分比,不再用一刀切的美元上限
InpRiskCapUSD=0.0
InpQuickProfitUSD=0.0
InpQuickLossUSD=0.0
; 所有百分比以 $200 为基准,而不是终端里的真实余额
InpVirtualBalanceUSD=200.0

; --- V2 评分与分级（规格 §28/§29）---
; 风险由 setup 质量给,不由"想赚多少"给。C 级(<5分)一律 NO TRADE。
InpUseV2Scoring=true
; 采样期降到 4:10 分制是新加的一道闸门,非扫损路径的流动性维度本就拿不满,
; 门槛留在 5 会把大量合格 setup 判成 C 级。等有样本了再按实测分数分布调回来。
InpScoreMinB=3
InpScoreMinA=7
InpScoreMinAPlus=9
InpRiskPctB=1.5
InpRiskPctA=3.0
InpRiskPctAPlus=5.0

; --- V2 结构位移 ---
; ⚠️ BOS/CHoCH 用的是代码里写死的机械定义,不是权威定义。见文件头注释。
InpUseBOS=true
InpBosBufferATR=0.05
InpRequireMtfAgree=false

; --- V2 波动率分档（规格 §13）---
; 用 ATR/自身均值 的比值,不用绝对数 —— 金价从 $2000 到 $4400,绝对 ATR 早就变了。
InpUseVolRegime=true
InpAtrAvgPeriod=96
InpVolHighMult=1.60
InpVolExtremeMult=2.40
InpVolHighSizeMult=0.60

; --- V2 日内限额改百分比（规格 §21/§23）---
; 规格的 +$50/-$30 是按 $200 写的。用百分比后同一份规格在任何余额上语义一致。
InpDailyTargetPct=50.0
InpDailyMaxLossPct=50.0
InpConservativeAtPct=30.0
InpReducedAtPct=40.0

; --- 多仓并行（规格 §30）---
; 加仓 = 往同一笔盈利单上追;多仓 = 各自独立的 setup + 各自独立止损。
; 真正该守的不是"只能一笔",而是**总在险金额上限**。
; 已移到保本之外的仓位按 0 计入在险 —— 那些确实没有敞口了。
InpAllowMultiPosition=true
InpMaxPositions=5
InpMaxCombinedRiskPct=15.0
InpMaxMarginPctPerPos=80.0
; 规格 §31:反向开仓是在掩盖错误,不是管理风险。保持禁止。
InpAllowHedge=false

; --- 宽松入场 路径D（采样用）---
; "无有效突破/回踩触发"长期是第一大拒绝原因。这条路径只要求顺势收盘 +
; 价格没过度偏离快线(防 FOMO 追高)。
; ⚠️ 它一定会拉低平均质量。单独标记路径,事后按路径分组比期望值,亏就关掉。
InpUseLooseEntry=true
InpLooseMaxDistATR=3.00

; --- 方向判定与冲突处理（本轮最关键的一项）---
; 实测拦路 "趋势不一致 HTF=1 LTF=-1" —— 两周期方向明确但相反,那正是**回调**。
; 而入场 B 就叫"趋势回调",它等的就是这一刻。要求两周期同向 = 把自己的回调
; 入场毙掉;「结构冲突」「动量冲突」同理,回调时必然冲突。
; 1 = H1 定方向,M5 只影响评分不否决
InpDirectionMode=3
; false = 冲突不否决,只写进成交备注,由 10 分制评分反映质量差异。
; 事后可按"有无冲突"分组比期望值 —— 若带冲突的单确实更差,再改回 true。
InpConflictAsVeto=false
InpInvertSignals=false
InpTrendVeto=false
InpTrendBars=4
InpTrendMinUSD=5.0
InpCounterMoveBars=5
InpCounterMoveATR=0.50
InpCounterMoveHardATR=1.00
InpPaBars=6
InpPaMinATR=0.30

; --- 新闻事件窗口（fomc 档会覆盖这几项）---
; 全部列全,否则从 fomc 档切回来时这几项会残留 —— .set 只覆盖它列出的项。
InpNewsBeforeMin=30
InpNewsAfterMin=20
InpManualNewsTimes=
; >0 = 重大数据前 N 分钟强制清仓。原新闻过滤只挡新开仓,已持仓会毫无保护
; 穿过事件 —— 跳空时止损不保证成交价。平时 0,事件日用 fomc 档。
InpFlatBeforeNewsMin=0

; --- 监控 ---
InpPushNotify=true
InpWriteStatusJson=true
InpVerboseLog=true

InpTesterQuiet=true
InpUseCommandFile=false
InpCommandMaxAgeMin=15
